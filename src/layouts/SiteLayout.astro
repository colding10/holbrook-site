---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  page: "index" | "about" | "archive" | "staff" | "404";
}

const { page } = Astro.props;
const canonical = new URL(page === "index" ? "/" : `/${page}`, site.url);
const titles = { index: "Joe Holbrook Memorial Math Competition", about: "Competition information", archive: "Exams, results & photos", staff: "Organizers", "404": "Page not found" };
const descriptions = {
  index: site.description,
  about: "Dates, eligibility, schedule, location, and rules for the Joe Holbrook Memorial Math Competition.",
  archive: "Browse past JHMMC exams, solutions, competition results, and photos.",
  staff: "Meet the JHMMC organizers, exam leaders, and past student directors.",
  "404": "This JHMMC page could not be found.",
};
const title = `${titles[page]} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={descriptions[page]} />
    <meta name="author" content={site.maintainer.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descriptions[page]} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {page === "404" && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {page !== "404" && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link href="/css/materialize.min.css" type="text/css" rel="stylesheet" media="screen,projection" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script is:inline src="/js/materialize.min.js"></script>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
