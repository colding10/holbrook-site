---
import { onlineRegistrationOpen, registration } from "../data/registration";
---
<div class="registration-links">
  {onlineRegistrationOpen && (
    <>
      <p><strong>Online registration closes Thursday morning, November 12.</strong></p>
      <ul aria-label="Online registration by grade">
        {registration.map(({ label, day, url }) => <li><a href={url}>{label}</a>: {day}</li>)}
      </ul>
    </>
  )}
  <p>Walk-in registration is available each day for $50 (cash only).</p>
</div>
<style>
  p { margin: .75rem 0; line-height: 1.6; }
  ul { margin: .75rem 0; }
  li + li { margin-top: .5rem; }
  a { font-weight: 500; text-decoration: underline; text-underline-offset: .2em; }
</style>
