---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout page="index">
<main>
            <div class="slider">
                <ul class="slides">
                    <li>
                        <img src="/images/background1.jpg" alt="Students at the Joe Holbrook Memorial Math Competition" />
                        <div class="caption center-align">
                            <h3>14th Annual Joe Holbrook Memorial Math Competition</h3>
                            <h5 class="light grey-text text-lighten-3">
                                October 11-12, 2025 at the Bergen County Academies
                            </h5>
                        </div>
                    </li>
                    <li>
                        <img src="/images/background2.jpg" alt="BCA Math Team competition organizers" />
                        <div class="caption left-align">
                            <h3>Organized by the BCA Math Team</h3>
                            <h5 class="light grey-text text-lighten-3">Meet and compete with fellow students!</h5>
                        </div>
                    </li>
                    <li>
                        <img src="/images/background3.jpg" alt="Awards and prizes at JHMMC" />
                        <div class="caption right-align">
                            <h3>Win awards and prizes!</h3>
                            <h5 class="light grey-text text-lighten-3">Available for each grade, from 4th to 8th.</h5>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="container">
                <div class="section">
                    <blockquote>
                        The 14th annual JHMMC took place on October 11-12, 2025. Full results and tests are now available on the
                        <a href="/archive">Archive</a> page. Thanks to all those who competed!
                    </blockquote>
                    
                    <div class="row">
                        <div class="col s12 m6">
                            <div class="icon-block">
                                <a href="https://bcts.bergen.org/index.php/bca-home">
                                    <h2 class="center brown-text"><i class="material-icons">school</i></h2>
                                </a>
                                <h5 class="center">Hosted at the Bergen County Academies</h5>

                                <p class="light">
                                    The <i>BCA Math Team</i>
                                    proudly presented the 14th Annual Joe Holbrook Memorial Math Competition, formerly
                                    known as the BCAMC, on October 11-12, 2025. This competition brought the best and
                                    brightest elementary and middle school students from the greater Bergen County area
                                    to meet and compete with fellow students.
                                </p>
                                <p>
                                    To see more information about the Bergen County Academies Math Team, visit its
                                    official website at <a href="https://bcamathteam.org">https://bcamathteam.org.</a>
                                </p>
                            </div>
                        </div>
                        <div class="col s12 m6">
                            <div class="icon-block">
                                <a href="/archive">
                                    <h2 class="center brown-text"><i class="material-icons">assignment_ind</i></h2>
                                </a>
                                <h5 class="center">View Past Competitions</h5>
                                <p class="light">
                                    The 2025 JHMMC was held across two days separated by grade, with grades 4-6 competing on 
                                    Saturday, October 11, and grades 7-8 competing on Sunday, October 12.
                                </p>
                                <p class="light">
                                    All exams, solutions, and results from 2025 and previous years are available on the
                                    <a href="/archive">Archive</a> page.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container">
                <div class="col s12" style="text-align: center">
                    <h3>Sponsors</h3>
                </div>
                <div class="row">
                    <div class="col s4">
                        <a href="https://www.lingoace.com/"
                            ><img class="logo img-responsive" src="/images/LingoAce.jpg" alt="LingoAce"
                        /></a>
                    </div>
                    <div class="col s4">
                        <a href="http://www.artofproblemsolving.com/"
                            ><img class="logo img-responsive" src="/images/aops.png" alt="Art of Problem Solving"
                        /></a>
                    </div>
                    <div class="col s4">
                        <a href="https://quantumcomputinginc.com/"
                            ><img class="logo img-responsive" src="/images/quantum.jpeg" alt="Quantum Computing Inc."
                        /></a>
                    </div>
                </div>
                <div class="row">
                    <div class="col s4">
                        <a href="https://live.poshenloh.com/"
                            ><img class="logo img-responsive" src="/images/live.png" alt="LIVE - Po-Shen Loh"
                        /></a>
                    </div>
                    <div class="col s4">
                        <img class="logo img-responsive" src="/images/Azure.png" alt="Azure Partners" />
                    </div>
                    <div class="col s4">
                        <h4 class="center">The Plotnick Family</h4>
                    </div>
                </div>
                <div class="row">
                    <div class="col s4 offset-s2">
                        <h4 class="center">The Huang Family</h4>
                    </div>
                    <div class="col s4">
                        <h4 class="center">The Chen & Hong Family</h4>
                    </div>
                </div>
            </div>
        </main>
</SiteLayout>
