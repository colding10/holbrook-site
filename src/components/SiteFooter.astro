---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="page-footer white">
  <div class="container">
    <div class="footer-grid">
      <a href="https://bcts.bergen.org/index.php/bca-home" class="school-logo">
        <img src="/images/bcacolor.png" alt="Bergen County Academies" height="110" loading="lazy" decoding="async" />
      </a>
      <div>
        <h2>Connect</h2>
        <ul>
          <li><a href="https://bcamathteam.org/">BCA Math Team</a></li>
          <li><a href="https://bcts.bergen.org/index.php/bca-home">Bergen County Academies</a></li>
          <li><a href="https://www.facebook.com/Joe-Holbrook-Memorial-Math-Competition-470281533772274/">JHMMC Facebook page</a></li>
        </ul>
      </div>
      <div>
        <h2>Coaches</h2>
        <ul><li>Dr. Michael Abramson</li><li>Mr. Jon Pinyan</li></ul>
      </div>
    </div>
    <div class="credits">
      <p>Website developed by Daniel Kim</p>
      <p>Maintained by <a href={`mailto:${site.maintainer.email}`}>{site.maintainer.name}</a></p>
    </div>
  </div>
  <div class="footer-copyright">
    <div class="container">&copy; {year} JHMMC &bull; Bergen County Academies</div>
  </div>
</footer>
<style>
  footer.page-footer { border-top: 1px solid #e7e7e7; color: #444; padding-top: 2.5rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1.5fr 1fr; gap: 2rem; align-items: start; }
  h2 { font-size: 1.25rem; margin: 0 0 1rem; }
  li { margin-bottom: .5rem; }
  a { color: inherit; }
  a:hover { text-decoration: underline; }
  .school-logo img { max-width: 100%; height: 110px; object-fit: contain; }
  .credits { display: flex; flex-wrap: wrap; gap: .5rem 2rem; padding-block: 1.5rem; font-size: .95rem; }
  .credits p { margin: 0; }
  .credits a { text-decoration: underline; text-underline-offset: .2em; }
  .footer-copyright { color: #555; }
  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .school-logo { grid-column: 1 / -1; }
    .credits { flex-direction: column; }
  }
</style>
