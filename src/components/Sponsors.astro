---
import { sponsors, familySponsors } from "../data/sponsors";
---
<section class="container sponsors" aria-labelledby="sponsors-title">
  <h2 id="sponsors-title">Sponsors</h2>
  <ul class="sponsor-grid">
    {sponsors.map(({ name, image, url }) => (
      <li>
        {url ? (
          <a href={url}><img src={image} alt={name} loading="lazy" decoding="async" width="240" height="120" /></a>
        ) : (
          <img src={image} alt={name} loading="lazy" decoding="async" width="240" height="120" />
        )}
      </li>
    ))}
  </ul>
  <ul class="family-sponsors">
    {familySponsors.map((name) => <li>{name}</li>)}
  </ul>
</section>
<style>
  .sponsors { padding-block: 1.5rem 3rem; border-top: 1px solid #e7e7e7; text-align: center; }
  h2 { font-size: 2rem; margin: 1rem 0 2rem; }
  .sponsor-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; align-items: center; }
  .sponsor-grid li { display: flex; align-items: center; justify-content: center; min-height: 120px; }
  .sponsor-grid a { display: block; }
  img { display: block; width: 100%; max-width: 240px; height: 120px; object-fit: contain; }
  .family-sponsors { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem 3rem; margin-top: 2.5rem; font-size: 1.25rem; }
  @media (max-width: 600px) {
    .sponsor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    img { height: 90px; }
    .sponsor-grid li { min-height: 90px; }
    .family-sponsors { flex-direction: column; }
  }
</style>
