                        <p class="black-text"><em>Website developed by Daniel Kim</em></p>
                        <p class="black-text"><em>Maintained by <a class="black-text" href={`mailto:${site.maintainer.email}`}>{site.maintainer.name}</a></em></p>
                    </div>
                </div>
            </div>
            <div class="footer-copyright">
                <div class="container black-text">&copy; 2025 JHMMC &bull; Bergen County Academies</div>
            </div>
        </footer>
